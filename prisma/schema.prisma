generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PermissionEffect {
  GRANT
  DENY
}

enum PermissionScope {
  GLOBAL
  SECTION
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestField {
  NAME
  DATE_OF_BIRTH
  EMAIL
  ENROLLMENT_NUMBER
  EMPLOYEE_ID
  DEPARTMENT
  COURSE
  BATCH
}

// =============================================================================
// USER
// =============================================================================

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String?
  name              String
  role              UserRole
  status            UserStatus @default(ACTIVE)
  failedLoginCount  Int        @default(0)
  lockedAt          DateTime?
  lastLoginAt       DateTime?
  isEmailVerified   Boolean    @default(false)
  emailVerifiedAt   DateTime?
  isProfileComplete Boolean    @default(false)
  createdById       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  passwordSetupTokens     PasswordSetupToken[]
  emailVerificationTokens EmailVerificationToken[]
  userPermissions         UserPermission[]

  profileChangeRequests  ProfileChangeRequest[] @relation("ProfileChangeRequester")
  reviewedChangeRequests ProfileChangeRequest[] @relation("ProfileChangeReviewer")

  superAdminProfile SuperAdminProfile?
  adminProfile      AdminProfile?
  staffProfile      StaffProfile?
  studentProfile    StudentProfile?

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
}

// =============================================================================
// ROLE PROFILES
// =============================================================================

model SuperAdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User-editable
  phone           String?
  profilePhotoKey String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin-controlled (set by Super Admin)
  department  String?
  employeeId  String?   @unique
  joiningDate DateTime?

  // User-editable
  phone            String?
  alternatePhone   String?
  address          String?
  city             String?
  state            String?
  profilePhotoKey  String?
  emergencyContact Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([department])
  @@index([employeeId])
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin-controlled (set by Admin/Super Admin only)
  department  String?
  designation String?
  employeeId  String?   @unique
  joiningDate DateTime?
  reportingTo String? // userId of reporting manager

  // User-editable
  phone            String?
  alternatePhone   String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  profilePhotoKey  String?
  bio              String?
  emergencyContact Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([department])
  @@index([employeeId])
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin-controlled (set by Admin/Staff only)
  department       String?
  course           String?
  batch            String?
  enrollmentNumber String?   @unique
  admissionDate    DateTime?
  academicYear     String?
  section          String?
  dateOfBirth      DateTime? // official — change requires approval

  // User-editable
  phone            String?
  alternatePhone   String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  profilePhotoKey  String?
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?
  emergencyContact Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([department])
  @@index([course])
  @@index([batch])
  @@index([enrollmentNumber])
}

// =============================================================================
// PROFILE CHANGE REQUESTS
// =============================================================================

model ProfileChangeRequest {
  id         String              @id @default(cuid())
  userId     String
  field      ChangeRequestField
  oldValue   String
  newValue   String
  reason     String?
  status     ChangeRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user     User  @relation("ProfileChangeRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ProfileChangeReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([field])
  @@index([reviewedBy])
  @@index([createdAt])
  @@index([status, createdAt])
}

// =============================================================================
// PERMISSIONS
// =============================================================================

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles           RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([role])
}

model UserPermission {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  scopeType    PermissionScope  @default(GLOBAL)
  scopeId      String?
  effect       PermissionEffect @default(GRANT)
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, scopeType, scopeId])
  @@index([userId])
  @@index([permissionId])
  @@index([scopeType, scopeId])
}

// =============================================================================
// AUTH TOKENS
// =============================================================================

model RefreshToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  hash      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id        String        @id @default(cuid())
  userId    String?
  userEmail String?
  userRole  String?
  action    String
  severity  AuditSeverity @default(LOW)
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([userEmail])
  @@index([action])
  @@index([severity])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([severity, createdAt])
}
