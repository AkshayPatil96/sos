# Application
NODE_ENV=development
PORT=3000
APP_NAME=student-onboarding-api
API_VERSION=v1
FRONTEND_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://student_user:student_pass@postgres:5432/student_db
DB_POOL_MIN=2
DB_POOL_MAX=10
# When running locally without Docker, replace @postgres with @localhost

# Auth
JWT_ACCESS_SECRET=replace-with-32-char-random-secret-here!!
JWT_REFRESH_SECRET=replace-with-another-32-char-secret!!

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS (optional in dev)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_URL_EXPIRY=900

# Logging
LOG_LEVEL=debug

# Sentry (optional — leave blank to disable error tracking in dev)
SENTRY_DSN=

# Monitoring — set to false to disable Sentry, Prometheus metrics, and Grafana
ENABLE_MONITORING=true

# Grafana (for docker-compose monitoring stack)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# DB credentials (for docker-compose)
DB_USER=student_user
DB_PASSWORD=student_pass
DB_NAME=student_db
